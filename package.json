{
  "name": "sill",
  "version": "0.1.0",
  "private": true,
  "description": "Sill — a glass side rail for the Windows desktop",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @sill/desktop dev",
    "build": "pnpm --filter @sill/desktop build",
    "typecheck": "pnpm --filter @sill/desktop typecheck",
    "smoke": "pnpm --filter @sill/desktop smoke",
    "dist": "pnpm --filter @sill/desktop dist",
    "dist:dir": "pnpm --filter @sill/desktop dist:dir"
  }
}
